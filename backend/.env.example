INSTICHAIN_APP_NAME=InstiChain API
# Absolute path to a protected server-side administrator Ed25519 key.
# INSTICHAIN_ADMIN_SIGNING_KEY_FILE=/absolute/path/to/backend/.keys/admin.pem
# Optional short-lived token with drive.file scope, used only by preflight CLI.
# INSTICHAIN_DRIVE_TEST_ACCESS_TOKEN=
# INSTICHAIN_DRIVE_TEST_FILE_ID=
# Local development only; replace credentials for any shared environment.
INSTICHAIN_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/instichain
INSTICHAIN_DATABASE_USER=instichain
INSTICHAIN_DATABASE_PASSWORD=instichain
INSTICHAIN_PUBLIC_APP_URL=http://127.0.0.1:5173
INSTICHAIN_VERIFICATION_TTL_MINUTES=15
INSTICHAIN_SESSION_TTL_DAYS=30
# Local Mailpit inbox. Use your SMTP provider with starttls or ssl for real mail.
INSTICHAIN_SMTP_HOST=127.0.0.1
INSTICHAIN_SMTP_PORT=1025
INSTICHAIN_SMTP_SECURITY=plain
INSTICHAIN_SMTP_FROM=InstiChain <no-reply@instichain.local>
# INSTICHAIN_SMTP_USERNAME=
# INSTICHAIN_SMTP_PASSWORD=
# make backend discovers the local test-network crypto path automatically.
# Set this explicitly when running the backend another way.
# INSTICHAIN_FABRIC_CRYPTO_PATH=/absolute/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
INSTICHAIN_FABRIC_CHANNEL_NAME=instichain
INSTICHAIN_FABRIC_CHAINCODE_NAME=instichain
INSTICHAIN_FABRIC_MSP_ID=Org1MSP
INSTICHAIN_FABRIC_PEER_ENDPOINT=localhost:7051
INSTICHAIN_FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
